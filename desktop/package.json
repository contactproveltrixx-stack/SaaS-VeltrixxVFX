{
  "name": "croisette",
  "productName": "SaaS Veltrixx",
  "version": "1.3.0",
  "description": "SaaS Veltrixx — gestion de VeltrixxVFX",
  "main": "main.js",
  "author": "VeltrixxVFX",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.croisette.studio",
    "productName": "SaaS Veltrixx",
    "copyright": "VeltrixxVFX",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SaaS Veltrixx",
      "artifactName": "SaaS-Veltrixx-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "SaaS-Veltrixx.${ext}"
    }
  },
  "dependencies": {
    "imapflow": "^1.0.150",
    "mailparser": "^3.6.0",
    "nodemailer": "^6.9.0"
  }
}
